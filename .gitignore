# ── Secrets & credentials ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
cookies.txt
headers_auth.json
spotify_token*
.spotify_cache*
# librespot credential blob — generated on first auth, never commit
librespot_credentials.json
# persistent data volume directory
/data/

# ── Database backups ───────────────────────────────────────────────────────────
/backups/
*.sql

# ── Plex data ──────────────────────────────────────────────────────────────────
/plex/config/
/plex/transcode/

# ── Scrobbler config (generated by setup.bat) ──────────────────────────────────
/scrobbler/config/config.yaml

# ── Logs ───────────────────────────────────────────────────────────────────────
/logs/

# ── Download directories ───────────────────────────────────────────────────────
/downloads/
/temp/

# ── Partial download artifacts ─────────────────────────────────────────────────
*.part
*.ytdl
*.tmp

# ── Python ─────────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage

# ── Audio files (never commit audio to git) ────────────────────────────────────
*.flac
*.mp3
*.m4a
*.ogg
*.opus
*.wav
*.aac

# ── IDE / editor ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# AI / editor dot directories (managed via sourcerepo)
.*
!.github/
!.gitignore
!.gitattributes
!.gitmodules
!.editorconfig
!.nvmrc
!.node-version
!.python-version
!.tool-versions
!.prettierrc*
!.eslintrc*
!.stylelintrc*
!.babelrc*
!.browserslistrc
!.dockerignore
!.npmrc
!.yarnrc
!.yarnrc.yml
!.env.example
!.env.template
!.env.sample
!.sourcery.yml
!.deepsource.toml
skills/
skills-lock.json
docs/
templates/

# Dev-mode compose override (per-machine). Bind-mounts src/ for instant
# code reload. See LIKED_ARTISTS_EXPAND_V1 / OFFICIAL_SOURCE_FILTER_V1 era.
docker-compose.override.yml
docker-compose.override.yaml

