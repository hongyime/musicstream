# Docker Build Ignore List

# Dependencies
**/node_modules/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Local data & media
backups/
logs/
downloads/
data/
temp/

# Frontend build artifacts (we build these in the Dockerfile)
frontend/dist/
static/

# Environment and secrets
.env
.env.*
!.env.example
spotify_token.json
librespot_credentials.json

# Git
.git/
.gitignore
.gitattributes

# IDEs and Tools
.vscode/
.idea/
.claude/
.codeflicker/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.sourcery.yml
.deepsource.toml

# OS Files
.DS_Store
Thumbs.db

# Keep local state, test tooling and private material out of image contexts.
**/.git
**/.agents
**/.env*
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/tests
**/test_*.py
**/logs
**/backups
**/sessions
**/cookies*.txt
**/credentials.json
**/*.pem
**/*.key
