# musicstream .env.example
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── Spotify API ────────────────────────────────────────────────────────────────
# Get from: https://developer.spotify.com/dashboard
# Create an app, set redirect URI to http://127.0.0.1:8888/callback
# No client secret needed — musicstream uses PKCE auth
SPOTIFY_CLIENT_ID=
# Client secret needed for spotdl (Tier 3 fallback downloader)
# Get from: https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_SECRET=

# ── Spotify Premium Account (Tier 0: librespot direct CDN download) ────────────
# Requires a Spotify Premium account. Recommend a dedicated account (Family Plan).
# On first daemon start, librespot authenticates and saves a credential blob to
# ./data/librespot_credentials.json — after that SPOTIFY_PASSWORD is not used.
# You can remove SPOTIFY_PASSWORD from .env once the credential file exists.
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# ── Qobuz Authentication (Optional) ───────────────────────────────────────────
# Qobuz requires a paid subscription for FLAC downloads.
# Get Qobuz credentials from: https://www.qobuz.com/app/en-US/customer/subscription/overview
QOBUZ_EMAIL=
# MD5 hash of your Qobuz password. Generate with: python -c "import hashlib; print(hashlib.md5(b'your_password').hexdigest())"
QOBUZ_PASSWORD_MD5=

# ── ListenBrainz ───────────────────────────────────────────────────────────────
# Get token from: https://listenbrainz.org/profile/
LISTENBRAINZ_TOKEN=
# Your ListenBrainz username (used for CF recommendation API)
LISTENBRAINZ_USERNAME=

# ── Plex Media Server ──────────────────────────────────────────────────────────
# Claim token (valid for 4 minutes): https://www.plex.tv/claim/
PLEX_CLAIM_TOKEN=
# Your Plex account username or email
PLEX_USERNAME=
# X-Plex-Token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=
# Numeric ID of your Plex music library section (check Plex web UI → Settings → Libraries)
PLEX_LIBRARY_SECTION_ID=
# Plex base URL — use container name when running in Docker, localhost for local dev
PLEX_URL=http://musicstream-plex:32400

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Password for the musicstream PostgreSQL user (choose a strong password)
POSTGRES_PASSWORD=
# Connection URL — auto-constructed from POSTGRES_PASSWORD above
# Format: postgresql://musicstream:<POSTGRES_PASSWORD>@localhost:5432/musicstream
DATABASE_URL=postgresql://musicstream:your_password_here@localhost:5432/musicstream

# ── Network ────────────────────────────────────────────────────────────────────
# Your Tailscale IP (run: tailscale ip -4)
# Used to advertise Plex on your Tailscale network
TAILSCALE_IP=

# ── External Media Drive ───────────────────────────────────────────────────────
# Absolute path to your external HDD where music will be stored
# Example (Windows): E:\Music
# Example (Linux):   /mnt/external/music
# NO default — you MUST set this
EXTERNAL_MEDIA_DRIVE=

# ── AcoustID ───────────────────────────────────────────────────────────────────
# Get from: https://acoustid.org/api-key
# Used for acoustic fingerprinting (MusicBrainz lookup fallback)
ACOUSTID_API_KEY=

# ── Download configuration ─────────────────────────────────────────────────────
# Worker concurrency for parallel downloads (default: 12)
# Reduce if you hit API rate limits
MAX_CONCURRENT_WORKERS=12

# Set to 1/true/yes/on to DISABLE ALL DOWNLOADS (safe default for new installs — set to empty to enable)
# Spotify sync and ListenBrainz discovery still run when disabled
DISABLE_DOWNLOADS=
ENABLE_TIER1=true
SPOTIFLAC_SERVICES=qobuz,deezer

# ── Spotify token cache ────────────────────────────────────────────────────────
# Path inside the Docker container where the Spotify PKCE token is stored.
# Default matches the volume mount added by setup.bat.
# On the HOST, run: python -m src.ingestion.spotify_auth  (generates spotify_token.json)
# Then docker-compose.yml mounts ./spotify_token.json:/app/spotify_token.json
SPOTIFY_TOKEN_CACHE=/app/spotify_token.json

# ── Daemon API auth (audit #6 / #28) ───────────────────────────────────────────
# Bearer token enforced on all mutating daemon endpoints (POST /api/musicstream/*,
# /auth/spotify/login, etc.). Without a value the daemon fails CLOSED — every
# protected route returns 503 ("DAEMON_API_TOKEN not configured") and the
# dashboard cannot trigger syncs or integrity checks.
#
# Generate a strong token with one of:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#     openssl rand -base64 32
#
# Paste the same token into the dashboard token prompt (sessionStorage —
# cleared when you close the tab).
DAEMON_API_TOKEN=

# Local-dev bypass — set to "1" to disable Bearer-auth entirely. NEVER set in
# production. Leave empty to keep auth on.
DAEMON_DEV_NOAUTH=

# ── Rate-limiter persistence (audit #13) ───────────────────────────────────────
# Path where the per-service backoff state is checkpointed atomically.
# Default lives next to the librespot blob in the persistent /app/data volume.
THROTTLE_STATE_PATH=/app/data/throttle_state.json
