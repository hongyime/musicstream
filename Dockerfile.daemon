# --- Stage 1: Build React Frontend ---
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# --- Stage 2: Python Backend ---
FROM python:3.12-slim
WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y ffmpeg curl git libchromaprint-dev postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir yt-dlp-ejs

# Copy backend code
COPY . .

# Copy built frontend from Stage 1 to static directory
# Vite defaults to 'dist'
COPY --from=frontend-builder /app/frontend/dist ./static

EXPOSE 9079

# Use uvicorn to serve the FastAPI app
CMD ["uvicorn", "src.daemon:app", "--host", "0.0.0.0", "--port", "9079"]
