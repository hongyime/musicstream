# Audit #30: hardened multi-stage Dockerfile.
#
# Improvements over the previous version:
#   - npm ci (deterministic, fails on lockfile drift) instead of npm install
#   - non-root runtime user (uid/gid 1000) — daemon never needs root in
#     the container; the bind-mounted /media and /app/data only need to be
#     writable by 1000:1000 on the host
#   - explicit --workers 1 keeps the in-process scheduler + websocket
#     manager singletons; multi-worker would double-register cron jobs and
#     break the connection-set lock added in audit #15
#   - tini as PID 1 so SIGTERM from `docker stop` actually reaches uvicorn
#     and lifespan shutdown runs (without it uvicorn exits but pending
#     downloads are killed mid-flight)
#   - --no-install-recommends shrinks the runtime layer

# --- Stage 1: Build React Frontend ---
FROM node:26-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
# Use npm ci so the build fails fast on lockfile drift instead of
# silently shipping mismatched deps.  Falls back to npm install if no
# lockfile is present (e.g. fresh checkout in CI without a committed
# package-lock.json) — keep this conditional rather than hard-failing.
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY frontend/ ./
RUN npm run build

# --- Stage 2: Python Backend ---
FROM python:3.14-slim AS runtime
WORKDIR /app

# Install system dependencies + tini (signal forwarding) + gosu (entrypoint
# UID-drop). postgresql-client is pinned to MAJOR 16 to MATCH the Postgres 16
# server: a v17 client's pg_dump emits \restrict / SET transaction_timeout that
# a v16 server cannot cleanly restore. Installed from the PGDG apt repo, which
# carries major-version-specific client packages (Debian trixie ships only v17).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
         -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
         > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg git libchromaprint-dev postgresql-client-16 tini gosu unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Deno (≥2.3.0) so yt-dlp-ejs can solve YouTube's signature /
# n-challenge JavaScript.  Without a JS runtime, yt-dlp falls back to
# image-only formats and tier 4 dies with "Only images are available
# for download".  Deno is the default runtime expected by yt-dlp-ejs
# (auto-detected from PATH, no --js-runtimes flag needed) and ships as
# a single static binary, so it's lighter than Debian's nodejs (which
# is too old at v20 — yt-dlp-ejs needs Node ≥22).
RUN ARCH="$(uname -m)" \
    && case "$ARCH" in \
         x86_64)  DENO_TARGET=x86_64-unknown-linux-gnu ;; \
         aarch64) DENO_TARGET=aarch64-unknown-linux-gnu ;; \
         *) echo "unsupported arch for Deno: $ARCH"; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/deno.zip \
       "https://github.com/denoland/deno/releases/latest/download/deno-${DENO_TARGET}.zip" \
    && unzip -q /tmp/deno.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/deno \
    && rm /tmp/deno.zip \
    && /usr/local/bin/deno --version

# Create non-root runtime user.  uid/gid 1000 is conventional and matches
# the default first user on most Linux hosts so bind-mounted volumes
# (./data, ./logs, ./backups, the media drive) Just Work without chmod.
RUN groupadd --gid 1000 musicstream \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash musicstream

# Install Python dependencies as root (needed for system site-packages),
# then transfer ownership of /app to the runtime user.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir yt-dlp-ejs==0.8.0 \
    # yt-dlp breaks against YouTube changes every few weeks — always build
    # with the freshest release, not whatever requirements.txt pinned.
    && pip install --no-cache-dir --upgrade yt-dlp

# Copy backend code
COPY . .

# Copy built frontend from Stage 1 to static directory
COPY --from=frontend-builder /app/frontend/dist ./static

# Pre-create writable dirs the daemon will use, then hand /app to the
# runtime user.  Bind-mounts (/app/data, /app/logs, /app/backups) inherit
# their host owner but the entrypoint copes with that because the daemon
# only writes via tempfile + os.replace.
RUN mkdir -p /app/data /app/logs /app/backups /app/temp \
    && chown -R musicstream:musicstream /app

# Install entrypoint script that fixes bind-mount ownership at runtime
# (Docker Desktop on Windows/macOS doesn't honour build-time chown for
# bind-mounted dirs — their UID comes from the host) and then drops to
# the unprivileged user via gosu.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# Strip CRLF defensively — if the file is checked out on Windows with
# core.autocrlf=true, the shebang will be `#!/usr/bin/env bash\r` which
# kernel rejects with "no such file or directory".
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

# Note: we deliberately do NOT switch USER here.  The entrypoint runs as
# root for the duration of the chown, then execs into the daemon as
# `musicstream` via gosu.  This is the standard PID-1 init pattern.

EXPOSE 9079

# tini reaps zombies (yt-dlp / spotdl spawn many short-lived children)
# and forwards SIGTERM so lifespan shutdown actually runs.  Our wrapper
# script then drops to non-root before exec'ing uvicorn.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]

# --workers 1 is REQUIRED — see header comment.
CMD ["uvicorn", "src.daemon:app", "--host", "0.0.0.0", "--port", "9079", "--workers", "1"]
